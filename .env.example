# Copy to your shell environment (or the platform's settings); never commit real values.
# Protects the admin API, /admin and the MCP endpoint (/mcp). Without it those are disabled.
ADMIN_KEY=
# Optional: SHA-256 hashes (hex, comma separated) of agent keys that open /mcp only.
AGENT_KEY_HASHES=
# Public address used in llms.txt, sitemap.xml and mail links.
SITE_URL=https://www.skolappar.org
# Where SQLite and uploaded images live (a persistent disk in production).
DATA_DIR=./data
# Optional mail (see README "Mail"): cloudflare | brevo | resend | stub. Without it, mail is only logged.
MAIL_PROVIDER=
MAIL_FROM=Skolappar <hej@skolappar.com>
MAIL_API_KEY=
# cloudflare only
MAIL_CLOUDFLARE_ACCOUNT_ID=
# resend only
MAIL_API_URL=
